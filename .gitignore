# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/

# Environment
.env
*.env

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local data — the resume bank is personal; never commit it
*.db
*.sqlite
*.sqlite3
data/
drafts/

# Filled-in worksheets and generated resumes contain real career history and
# contact details. Blank templates in worksheets/ are fine to commit; anything
# written into is not. Match ANY extension — an earlier version of this rule
# only covered .yaml and a .filled.txt resume draft slipped past it.
worksheets/private/
worksheets/*.filled.*
worksheets/*.resume.*
*.filled.*

# OS / editors
.DS_Store
.idea/
.vscode/
